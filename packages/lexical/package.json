{
  "name": "@pilotiq/lexical",
  "version": "0.0.1",
  "description": "Lexical rich-text editor adapter for @pilotiq/panels",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq",
    "directory": "packages/lexical"
  },
  "homepage": "https://pilotiq.io",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@rudderjs/core": "^1.0.0",
    "@pilotiq/panels": "workspace:*",
    "react": ">=18",
    "react-dom": ">=18",
    "lexical": ">=0.20",
    "@lexical/react": ">=0.20",
    "@lexical/rich-text": ">=0.20",
    "@lexical/list": ">=0.20",
    "@lexical/link": ">=0.20",
    "@lexical/code": ">=0.20",
    "@lexical/utils": ">=0.20",
    "@floating-ui/dom": ">=1"
  },
  "devDependencies": {
    "@rudderjs/core": "^1.0.0",
    "@pilotiq/panels": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lexical": "^0.41.0",
    "@lexical/react": "^0.41.0",
    "@lexical/rich-text": "^0.41.0",
    "@lexical/list": "^0.41.0",
    "@lexical/link": "^0.41.0",
    "@lexical/code": "^0.41.0",
    "@lexical/utils": "^0.41.0",
    "@floating-ui/dom": "^1.6.0",
    "react": "^19.0.0",
    "typescript": "^5.4.0"
  },
  "author": "Suleiman Shahbari"
}
