{
  "name": "@pilotiq/tiptap",
  "version": "0.0.1",
  "description": "Tiptap rich-text editor adapter for @pilotiq/pilotiq — slash menu, draggable blocks, custom-block API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq",
    "directory": "packages/tiptap"
  },
  "homepage": "https://pilotiq.io",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./register": {
      "import": "./dist/register.js",
      "types": "./dist/register.d.ts"
    },
    "./render": {
      "import": "./dist/render.js",
      "types": "./dist/render.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"; EXIT=$?; rm -rf dist-test; exit $EXIT"
  },
  "dependencies": {},
  "peerDependencies": {
    "@pilotiq/pilotiq": "workspace:*",
    "@base-ui/react": "^1",
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/extension-underline": "3.22.4",
    "@tiptap/extension-subscript": "3.22.4",
    "@tiptap/extension-superscript": "3.22.4",
    "@tiptap/extension-text-align": "3.22.4",
    "@tiptap/extension-text-style": "3.22.4",
    "@tiptap/extension-color": "3.22.4",
    "@tiptap/extension-highlight": "3.22.4",
    "@tiptap/extension-image": "3.22.4",
    "@tiptap/extension-table": "3.22.4",
    "@tiptap/suggestion": "^3",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@pilotiq/pilotiq": "workspace:*",
    "@base-ui/react": "^1",
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/extension-underline": "3.22.4",
    "@tiptap/extension-subscript": "3.22.4",
    "@tiptap/extension-superscript": "3.22.4",
    "@tiptap/extension-text-align": "3.22.4",
    "@tiptap/extension-text-style": "3.22.4",
    "@tiptap/extension-color": "3.22.4",
    "@tiptap/extension-highlight": "3.22.4",
    "@tiptap/extension-image": "3.22.4",
    "@tiptap/extension-table": "3.22.4",
    "@tiptap/suggestion": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5"
  },
  "author": "Suleiman Shahbari"
}
