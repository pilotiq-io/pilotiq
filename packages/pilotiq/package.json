{
  "name": "@pilotiq/pilotiq",
  "version": "0.7.0",
  "description": "View-based admin panel for RudderJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq",
    "directory": "packages/pilotiq"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./registry": {
      "import": "./dist/PilotiqRegistry.js",
      "types": "./dist/PilotiqRegistry.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./icons": {
      "import": "./dist/icons/index.js",
      "types": "./dist/icons/index.d.ts"
    },
    "./icons/lucide": {
      "import": "./dist/icons/lucide.js",
      "types": "./dist/icons/lucide.d.ts"
    },
    "./uploads": {
      "import": "./dist/uploads/index.js",
      "types": "./dist/uploads/index.d.ts"
    },
    "./widgets": {
      "import": "./dist/widgets/index.js",
      "types": "./dist/widgets/index.d.ts"
    },
    "./entries": {
      "import": "./dist/entries/index.js",
      "types": "./dist/entries/index.d.ts"
    },
    "./slot-components": {
      "import": "./dist/slot-components/index.js",
      "types": "./dist/slot-components/index.d.ts"
    },
    "./richtext": {
      "import": "./dist/richtext/index.js",
      "types": "./dist/richtext/index.d.ts"
    },
    "./styles/file-upload.css": "./dist/styles/file-upload.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm run copy-assets",
    "dev": "tsc -p tsconfig.build.json --watch & pnpm run copy-assets; wait",
    "copy-assets": "mkdir -p dist/styles && cp -R src/styles/*.css dist/styles/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"; EXIT=$?; rm -rf dist-test; exit $EXIT"
  },
  "dependencies": {
    "jiti": "^2.6.0",
    "marked": "^14",
    "react-image-crop": "^11.0.10",
    "sanitize-html": "^2.17.3"
  },
  "peerDependencies": {
    "@base-ui/react": "^1",
    "@rudderjs/contracts": "^1.3.0",
    "@rudderjs/core": "^1.1.2",
    "@rudderjs/router": "^1.1.2",
    "@rudderjs/view": "^1.0.1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.503",
    "react": "^18 || ^19",
    "react-day-picker": "^9",
    "tailwind-merge": "^3"
  },
  "devDependencies": {
    "@base-ui/react": "^1",
    "@rudderjs/contracts": "^1.3.0",
    "@rudderjs/core": "^1.1.2",
    "@rudderjs/router": "^1.1.2",
    "@rudderjs/view": "^1.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/sanitize-html": "^2.16.1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.503",
    "react": "^19",
    "react-day-picker": "^9",
    "tailwind-merge": "^3",
    "typescript": "^5",
    "vite": "^7"
  }
}
