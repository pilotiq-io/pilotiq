{
  "name": "@pilotiq/pilotiq",
  "version": "0.0.1",
  "description": "View-based admin panel for RudderJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq",
    "directory": "packages/pilotiq"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./registry": {
      "import": "./dist/PilotiqRegistry.js",
      "types": "./dist/PilotiqRegistry.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"; EXIT=$?; rm -rf dist-test; exit $EXIT"
  },
  "peerDependencies": {
    "@rudderjs/contracts": "workspace:*",
    "@rudderjs/core": "workspace:*",
    "@rudderjs/router": "workspace:*",
    "@rudderjs/view": "workspace:*",
    "@base-ui/react": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.503",
    "tailwind-merge": "^3",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@rudderjs/contracts": "workspace:*",
    "@rudderjs/core": "workspace:*",
    "@rudderjs/router": "workspace:*",
    "@rudderjs/view": "workspace:*",
    "@base-ui/react": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.503",
    "tailwind-merge": "^3",
    "@types/node": "^20",
    "vite": "^7",
    "@types/react": "^19",
    "react": "^19",
    "typescript": "^5"
  }
}
