{
  "name": "@pilotiq/codemirror",
  "version": "0.2.0",
  "description": "CodeMirror 6 code-editor field adapter for @pilotiq/pilotiq — syntax highlight, line numbers, language registry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq",
    "directory": "packages/codemirror"
  },
  "homepage": "https://pilotiq.io",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./register": {
      "import": "./dist/register.js",
      "types": "./dist/register.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\"; EXIT=$?; rm -rf dist-test; exit $EXIT"
  },
  "dependencies": {},
  "peerDependencies": {
    "@pilotiq/pilotiq": "workspace:*",
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@uiw/react-codemirror": "^4",
    "codemirror": "^6",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@pilotiq/pilotiq": "workspace:*",
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@uiw/react-codemirror": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "codemirror": "^6",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5"
  },
  "author": "Suleiman Shahbari"
}
