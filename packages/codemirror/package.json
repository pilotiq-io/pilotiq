{
  "name": "@pilotiq/codemirror",
  "version": "3.2.8",
  "description": "CodeMirror 6 code-editor field adapter for @pilotiq/pilotiq — syntax highlight, line numbers, language registry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq",
    "directory": "packages/codemirror"
  },
  "homepage": "https://pilotiq.io",
  "type": "module",
  "files": [
    "dist",
    "boost",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./register": {
      "import": "./dist/register.js",
      "types": "./dist/register.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --import ./dist-test/test/setup.js --test \"dist-test/**/*.test.js\"; EXIT=$?; rm -rf dist-test; exit $EXIT"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@pilotiq/pilotiq": ">=0.6.0 <1.0.0",
    "@rudderjs/sync": "^1.3.0",
    "@uiw/react-codemirror": "^4",
    "codemirror": "^6",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "y-codemirror.next": "^0.3",
    "yjs": "^13"
  },
  "devDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@pilotiq/pilotiq": "workspace:^",
    "@rudderjs/sync": "^1.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@uiw/react-codemirror": "^4",
    "codemirror": "^6",
    "jsdom": "^29.1.1",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "y-codemirror.next": "^0.3",
    "yjs": "^13"
  },
  "author": "Suleiman Shahbari"
}
