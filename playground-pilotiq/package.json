{
  "name": "pilotiq-playground-pilotiq",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev --port 3003",
    "dev:clean": "pids=$(lsof -ti :24680 -ti :3003 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; vike dev --port 3003",
    "build": "vike build",
    "start": "node ./dist/server/index.mjs",
    "preview": "pids=$(lsof -ti :3003 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; node ./dist/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "rudder": "tsx node_modules/@rudderjs/cli/src/index.ts"
  },
  "dependencies": {
    "@pilotiq/pilotiq": "workspace:*",
    "@pilotiq/tiptap": "workspace:*",
    "@pilotiq/codemirror": "workspace:*",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@uiw/react-codemirror": "^4",
    "codemirror": "^6",
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/suggestion": "^3",
    "@base-ui/react": "^1",
    "lucide-react": "^0.503",
    "react-day-picker": "^9",
    "clsx": "^2",
    "tailwind-merge": "^3",
    "class-variance-authority": "^0.7",
    "zod": "^4",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "@rudderjs/cache": "workspace:*",
    "@rudderjs/contracts": "workspace:*",
    "@rudderjs/core": "workspace:*",
    "@rudderjs/localization": "workspace:*",
    "@rudderjs/log": "workspace:*",
    "@rudderjs/middleware": "workspace:*",
    "@rudderjs/orm": "workspace:*",
    "@rudderjs/orm-prisma": "workspace:*",
    "@rudderjs/router": "workspace:*",
    "@rudderjs/console": "workspace:*",
    "@rudderjs/server-hono": "workspace:*",
    "@rudderjs/session": "workspace:*",
    "@rudderjs/view": "workspace:*",
    "@rudderjs/vite": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "vike": "^0.4.257",
    "@vikejs/hono": "^0.2.0",
    "vike-react": "^0.6.20"
  },
  "devDependencies": {
    "@rudderjs/cli": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^7.1.0"
  }
}
