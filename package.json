{
  "name": "pilotiq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "description": "Pilotiq — open-source admin and CMS for RudderJS, with a built-in agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/pilotiq-io/pilotiq"
  },
  "homepage": "https://pilotiq.io",
  "license": "MIT",
  "author": "Suleiman Shahbari",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm build && pnpm -r publish --access public --no-git-checks"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@rudderjs/core": "link:../rudderjs/packages/core",
      "@rudderjs/router": "link:../rudderjs/packages/router",
      "@rudderjs/support": "link:../rudderjs/packages/support",
      "@rudderjs/ai": "link:../rudderjs/packages/ai",
      "@rudderjs/orm": "link:../rudderjs/packages/orm",
      "@rudderjs/cache": "link:../rudderjs/packages/cache",
      "@rudderjs/storage": "link:../rudderjs/packages/storage",
      "@rudderjs/image": "link:../rudderjs/packages/image",
      "@rudderjs/broadcast": "link:../rudderjs/packages/broadcast",
      "@rudderjs/live": "link:../rudderjs/packages/live",
      "@rudderjs/localization": "link:../rudderjs/packages/localization"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.1"
  }
}
