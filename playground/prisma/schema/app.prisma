model Article {
  id              String     @id @default(cuid())
  title           String     @default("")
  slug            String?    @unique
  excerpt         String?
  coverImage      String?
  tags            String     @default("[]")  // JSON-encoded string[]
  status          String     @default("draft")
  draftStatus     String     @default("draft")  // draftable: 'draft' | 'published'
  featured        Boolean    @default(false)
  publishedAt     DateTime?
  accentColor     String?
  metaTitle       String?
  metaDescription String?
  content         Json?
  body            Json?      // Lexical editor state JSON
  metadata        String?    // JSON blob
  categories      Category[]
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  position  Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  articles  Article[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  title       String
  body        String?
  status      String    @default("draft")
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Plan #13 — soft-delete column. PostResource.softDeletes = true;
  // Post.softDeletes = true on the rudder Model side.
  deletedAt   DateTime?
  // Reorderable rows demo — column the drag handler writes back to.
  // PostResource.table().reorderable('sort') opts in; Post.reorder(ids)
  // re-stamps this column 1..n in array order.
  sort        Int       @default(0)
}

// Many-to-many — Article <-> Tag, via an *explicit* pivot table.
// rudder ORM's `belongsToMany` accessor writes pivot rows directly
// through raw queries (`insertMany` / `deleteAll`), so neither Tag
// nor Article needs a Prisma `@relation` array — the pivot table is
// a pure data container, not part of Prisma's relation graph.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArticleTag {
  articleId String
  tagId     String
  @@id([articleId, tagId])
  @@map("article_tag")
}

// Polymorphic follow-up — Comment can attach to Post OR Video via the
// camelCase `commentableId` + `commentableType` columns (rudder ORM
// camelCase divergence from Laravel snake_case). Reads + writes flow
// through `Comment.relations.commentable` (morphTo) and
// `Post.relations.comments` / `Video.relations.comments` (morphMany).
model Comment {
  id              String   @id @default(cuid())
  body            String
  commentableId   String
  commentableType String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([commentableId, commentableType])
}

// Phase B nested-resources demo — `Comment` owns `Reply` rows (hasMany).
// Mounts under the depth-2 URL `posts/:postId/comments/:commentId/replies`
// once `PostsCommentsManager.relations()` returns `[CommentRepliesManager]`.
model Reply {
  id        String   @id @default(cuid())
  commentId String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commentId])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Polymorphic many-to-many follow-up — one shared `taggable` pivot
// distinguished by `taggableType`. Post.tags() (morphToMany) and
// Tag.posts() / Tag.videos() (morphedByMany) all flow through this
// table; the rudder ORM stamps + filters the discriminator for us.
// The pilotiq RelationManager M2M follow-up plumbs morphToMany +
// morphedByMany through the same attach / detach / sync surface as
// the explicit `belongsToMany` Article ↔ Tag pivot above.
model Taggable {
  tagId        String
  taggableId   String
  taggableType String

  @@id([tagId, taggableId, taggableType])
  @@index([taggableId, taggableType])
  @@map("taggable")
}
