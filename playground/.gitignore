node_modules/

# Environment
.env
.env.*
!.env.example

# Forge CLI state (color rotation persistence)
.forge-cli-state.json

# Cache & tooling
.turbo/
*.log
dev.db
bootstrap/cache/

# NOTE: pages/(pilotiq)/ is auto-generated by @pilotiq/pilotiq's Vite
# plugin (vite.ts → generatePages + writeComponentsManifest +
# writeLayoutWithManifest) and IS committed. Vike uses `git ls-files`
# for page discovery — gitignored files exist on disk but Vike doesn't
# see them, and every pilotiq route 404s. The `pretypecheck` hook in
# package.json regenerates them so they stay in sync with vite.ts; if
# the regen produces a diff, commit it.

# Storage uploads
storage/app/
public/storage

# Playwright
test-results/
