{
  "name": "pilotiq-playground",
  "version": "0.0.91",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node --env-file-if-exists=.env node_modules/@rudderjs/cli/dist/index.js doctor",
    "rudder": "tsx --env-file-if-exists=.env node_modules/@rudderjs/cli/dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env node_modules/@rudderjs/cli/dist/index.js migrate",
    "dev": "vike dev --port 3003",
    "dev:clean": "pids=$(lsof -ti :24680 -ti :3003 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; vike dev --port 3003",
    "build": "vike build",
    "start": "node ./dist/server/index.mjs",
    "preview": "pids=$(lsof -ti :3003 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; node ./dist/server/index.mjs",
    "pretypecheck": "node scripts/regen-pilotiq-stubs.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1",
    "@codemirror/commands": "^6",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pilotiq/codemirror": "workspace:*",
    "@pilotiq/pilotiq": "workspace:*",
    "@pilotiq/recharts": "workspace:*",
    "@pilotiq/tiptap": "workspace:*",
    "@rudderjs/cache": "^1.5.0",
    "@rudderjs/console": "^1.4.0",
    "@rudderjs/contracts": "^1.17.0",
    "@rudderjs/core": "^1.12.2",
    "@rudderjs/database": "^1.5.1",
    "@rudderjs/localization": "^2.1.0",
    "@rudderjs/log": "^1.1.0",
    "@rudderjs/middleware": "^1.2.1",
    "@rudderjs/orm": "^1.20.0",
    "@rudderjs/router": "^1.9.0",
    "@rudderjs/server-hono": "^1.5.1",
    "@rudderjs/session": "^2.4.0",
    "@rudderjs/sync": "^1.6.0",
    "@rudderjs/view": "^1.3.0",
    "@rudderjs/vite": "^2.11.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/core": "^3",
    "@tiptap/extension-color": "3.26.0",
    "@tiptap/extension-details": "3.26.0",
    "@tiptap/extension-highlight": "3.26.0",
    "@tiptap/extension-image": "3.26.0",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/extension-subscript": "3.26.0",
    "@tiptap/extension-superscript": "3.26.0",
    "@tiptap/extension-table": "3.26.0",
    "@tiptap/extension-text-align": "3.26.0",
    "@tiptap/extension-text-style": "3.26.0",
    "@tiptap/extension-underline": "3.26.0",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/suggestion": "^3",
    "@uiw/react-codemirror": "^4",
    "@vikejs/hono": "^0.2.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "codemirror": "^6",
    "dotenv": "^16.4.0",
    "lucide-react": "^0.503",
    "marked": "^14",
    "prosemirror-changeset": "^2.4.1",
    "react": "^19.0.0",
    "react-day-picker": "^9",
    "react-dom": "^19.0.0",
    "react-image-crop": "^11.0.10",
    "recharts": "^2",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.3",
    "tailwind-merge": "^3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vike": "^0.4.257",
    "vike-react": "^0.6.20",
    "y-codemirror.next": "^0.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@rudderjs/cli": "^4.15.0",
