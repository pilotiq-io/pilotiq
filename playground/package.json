{
  "name": "pilotiq-playground",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev --port 3001",
    "dev:clean": "pids=$(lsof -ti :24679 -ti :3001 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; vike dev --port 3001",
    "build": "vike build",
    "start": "node ./dist/server/index.mjs",
    "preview": "pids=$(lsof -ti :3001 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; node ./dist/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "rudder": "tsx node_modules/@rudderjs/cli/src/index.ts"
  },
