{
  "name": "pilotiq-playground",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev --port 3003",
    "dev:clean": "pids=$(lsof -ti :24680 -ti :3003 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; vike dev --port 3003",
    "build": "vike build",
    "start": "node ./dist/server/index.mjs",
    "preview": "pids=$(lsof -ti :3003 2>/dev/null); if [ -n \"$pids\" ]; then kill -9 $pids; fi; node ./dist/server/index.mjs",
    "pretypecheck": "node scripts/regen-pilotiq-stubs.mjs",
    "typecheck": "tsc --noEmit",
    "rudder": "tsx node_modules/@rudderjs/cli/src/index.ts"
  },
  "dependencies": {
    "@pilotiq/pilotiq": "workspace:*",
    "@pilotiq/tiptap": "workspace:*",
    "@pilotiq/codemirror": "workspace:*",
    "@pilotiq/recharts": "workspace:*",
    "recharts": "^2",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@uiw/react-codemirror": "^4",
    "codemirror": "^6",
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "@tiptap/extension-link": "^3",
    "@tiptap/extension-placeholder": "^3",
    "@tiptap/extension-underline": "3.22.4",
    "@tiptap/extension-subscript": "3.22.4",
    "@tiptap/extension-superscript": "3.22.4",
    "@tiptap/extension-text-align": "3.22.4",
    "@tiptap/extension-text-style": "3.22.4",
    "@tiptap/extension-color": "3.22.4",
    "@tiptap/extension-highlight": "3.22.4",
    "@tiptap/extension-image": "3.22.4",
    "@tiptap/extension-table": "3.22.4",
    "@tiptap/extension-details": "3.22.4",
    "@tiptap/suggestion": "^3",
    "marked": "^14",
    "sanitize-html": "^2.17.3",
    "react-image-crop": "^11.0.10",
    "@base-ui/react": "^1",
    "lucide-react": "^0.503",
    "react-day-picker": "^9",
    "clsx": "^2",
    "tailwind-merge": "^3",
    "class-variance-authority": "^0.7",
    "zod": "^4",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.2.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "@rudderjs/cache": "^1.1.1",
    "@rudderjs/contracts": "^1.3.0",
    "@rudderjs/core": "^1.1.2",
    "@rudderjs/localization": "^1.0.2",
    "@rudderjs/log": "^1.0.1",
    "@rudderjs/middleware": "^1.0.1",
    "@rudderjs/orm": "^1.8.0",
    "@rudderjs/orm-prisma": "^1.5.0",
    "@rudderjs/router": "^1.1.2",
    "@rudderjs/console": "^1.0.0",
    "@rudderjs/server-hono": "^1.0.5",
    "@rudderjs/session": "^1.0.4",
    "@rudderjs/view": "^1.0.1",
    "@rudderjs/vite": "^1.0.1",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "vike": "^0.4.257",
    "@vikejs/hono": "^0.2.0",
    "vike-react": "^0.6.20"
  },
  "devDependencies": {
    "@rudderjs/cli": "^4.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^7.1.0"
  }
}
